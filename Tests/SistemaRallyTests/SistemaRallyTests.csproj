<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 para reflejar exactamente el runtime del proyecto principal (.NET Framework 4.8, WinForms). -->
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>SistemadeGestiondeRallyUniversitario.Tests</RootNamespace>
    <AssemblyName>SistemaRallyTests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Misma versión que el proyecto principal para reproducir el comportamiento real de acceso a datos. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
  </ItemGroup>

  <!-- Se referencia el código fuente real del proyecto principal (sin depender de System.Windows.Forms,
       que Models/Services/Data no usan) para probar la lógica exactamente como se ejecuta en producción. -->
  <ItemGroup>
    <Compile Include="..\..\Models\**\*.cs" LinkBase="ProjectSource\Models" />
    <Compile Include="..\..\Services\**\*.cs" LinkBase="ProjectSource\Services" />
    <Compile Include="..\..\Data\**\*.cs" LinkBase="ProjectSource\Data" />
  </ItemGroup>

</Project>
